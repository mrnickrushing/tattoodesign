# Flash Generator (/generate) is backed by Google's Gemini image generation API.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the image-generation model (defaults to gemini-2.5-flash-image).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI's image-output model. Codex models accept images as input but do not
# render images, so the OpenAI choice uses GPT Image 2.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Claude can direct and refine the visual prompt but only returns text. The
# Claude workflow therefore uses Claude for art direction and Gemini to render.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Postgres behind /api/library — the shared design library the phone, the iPad
# and the browser sync against (src/lib/library.ts). Without it that route
# reports the library as unconfigured; /api/generate is unaffected.
DATABASE_URL=
