# CanvasKit is WebAssembly, and it has to be served as such: a wasm response
# with the wrong content type fails to stream-compile, and the fallback error
# ("expected magic word") says nothing about the real cause.
/canvaskit.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted by the exporter, so they can be cached forever.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
